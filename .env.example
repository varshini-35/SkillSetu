PORT=4000
# Optional Vite API target for split local ports; defaults to http://localhost:4000.
# SKILLSETU_API_PROXY_TARGET=http://localhost:4000
DATABASE_URL=
SKILLSETU_STORAGE=json
DEMO_MODE=true
SKILLSETU_CONTENT_FILE=database/seeds/domestic-electrician-demo.json
SKILLSETU_STORE_FILE=data/skillsetu-demo-store.json
# Evidence bytes remain separate from PostgreSQL metadata. Configure durable storage for production uploads.
# SKILLSETU_EVIDENCE_DIR=/absolute/path/to/evidence
# Used only when DEMO_MODE=false to provision the initial authorized admin.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace administrator

# Additional exact origins are comma-separated; local development origins are built in.
# SKILLSETU_ALLOWED_ORIGINS=https://your-approved-host.example
