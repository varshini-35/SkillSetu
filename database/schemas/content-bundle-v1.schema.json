{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsetu.local/schemas/content-bundle-v1.schema.json",
  "title": "SkillSetu Content Bundle v1",
  "description": "Versioned QP/NOS, assessment and synthetic example data. Schema validity is not official source authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSet", "qualificationPacks", "standards", "performanceCriteria", "taskMappings", "vivaQuestions", "candidates", "assessmentExamples", "calibrationCases", "calibrationScores", "bridgeRecommendations"],
  "properties": {
    "schemaVersion": {"const":"1.0"},
    "contentSet": {"type":"object","additionalProperties":false,"required":["id","name","version","trade","classification","source","effectiveDate","approvalReference"],"properties":{"id":{"$ref":"#/$defs/id"},"occupationId":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"trade":{"type":"string","minLength":1},"classification":{"enum":["SYNTHETIC_DEMO","VERIFIED_AUTHORIZED"]},"source":{"type":"string","minLength":1},"effectiveDate":{"type":"string","format":"date"},"approvalReference":{"type":["string","null"]}}},
    "qualificationPacks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","title","trade","nsqfLevel","description"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/text"},"trade":{"$ref":"#/$defs/text"},"nsqfLevel":{"type":["integer","null"],"minimum":1,"maximum":10},"description":{"$ref":"#/$defs/text"}}}},
    "standards":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","qpId","title","description"],"properties":{"id":{"$ref":"#/$defs/id"},"qpId":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}}},
    "performanceCriteria":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","nosId","description","safetyCritical","anchors"],"properties":{"id":{"$ref":"#/$defs/id"},"nosId":{"$ref":"#/$defs/id"},"description":{"$ref":"#/$defs/text"},"safetyCritical":{"type":"boolean"},"anchors":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/anchor"}}}}},
    "taskMappings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","taskId","taskLabel","nosId","criterionIds"],"properties":{"id":{"$ref":"#/$defs/id"},"taskId":{"$ref":"#/$defs/id"},"taskLabel":{"$ref":"#/$defs/text"},"nosId":{"$ref":"#/$defs/id"},"criterionIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}}},
    "vivaQuestions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","nosId","question","expectedFocus","followUps"],"properties":{"id":{"$ref":"#/$defs/id"},"nosId":{"$ref":"#/$defs/id"},"taskId":{"type":["string","null"]},"question":{"$ref":"#/$defs/text"},"expectedFocus":{"$ref":"#/$defs/text"},"followUps":{"type":"array","items":{"type":"string"}}}}},
    "candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","name","language","yearsExperience","taskIds","synthetic"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"language":{"$ref":"#/$defs/text"},"yearsExperience":{"type":"number","minimum":0,"maximum":70},"taskIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"synthetic":{"const":true}}}},
    "assessmentExamples":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","candidateId","status","scores","humanSignoff","synthetic"],"properties":{"id":{"$ref":"#/$defs/id"},"candidateId":{"$ref":"#/$defs/id"},"status":{"enum":["DRAFT","IN_PROGRESS","AWAITING_REVIEW","APPROVED","RETURNED"]},"scores":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["criterionId","score","observation"],"properties":{"criterionId":{"$ref":"#/$defs/id"},"score":{"$ref":"#/$defs/score"},"observation":{"type":"string"}}}},"humanSignoff":{"enum":["PENDING","APPROVED","RETURNED"]},"synthetic":{"const":true}}}},
    "calibrationCases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","title","criterionId","expectedScore","synthetic"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/text"},"criterionId":{"$ref":"#/$defs/id"},"expectedScore":{"$ref":"#/$defs/score"},"synthetic":{"const":true}}}},
    "calibrationScores":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","caseId","assessorId","score"],"properties":{"id":{"$ref":"#/$defs/id"},"caseId":{"$ref":"#/$defs/id"},"assessorId":{"$ref":"#/$defs/id"},"score":{"$ref":"#/$defs/score"}}}},
    "bridgeRecommendations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","criterionId","title","rationale","resourceType","resourceReference"],"properties":{"id":{"$ref":"#/$defs/id"},"criterionId":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/text"},"rationale":{"$ref":"#/$defs/text"},"resourceType":{"$ref":"#/$defs/text"},"resourceReference":{"type":["string","null"]}}}}
  },
  "allOf":[{"if":{"properties":{"contentSet":{"properties":{"classification":{"const":"VERIFIED_AUTHORIZED"}},"required":["classification"]}},"required":["contentSet"]},"then":{"properties":{"contentSet":{"properties":{"approvalReference":{"type":"string","minLength":1}}}}}}],
  "$defs":{"id":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},"text":{"type":"string","minLength":1},"score":{"type":"integer","minimum":0,"maximum":4},"anchor":{"type":"object","additionalProperties":false,"required":["score","description"],"properties":{"score":{"$ref":"#/$defs/score"},"description":{"$ref":"#/$defs/text"}}}}
}
